rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function userEmail() {
      return request.auth.token.email;
    }

    function calendarDoc(calId) {
      return get(/databases/$(database)/documents/calendars/$(calId)).data;
    }

    function isAuthorized(calId) {
      return request.auth != null && (
        calendarDoc(calId).ownerEmail == userEmail() ||
        userEmail() in calendarDoc(calId).collaborators
      );
    }

    // Calendario compartido: owner + colaboradores leen. Escritura solo server (admin).
    match /calendars/{calId} {
      allow read: if request.auth != null && (
        resource.data.ownerEmail == userEmail() ||
        userEmail() in resource.data.collaborators
      );
      allow write: if false;
    }

    // Eventos del calendario: hereda permisos del calendario padre.
    match /calendars/{calId}/events/{eventId} {
      allow read: if isAuthorized(calId);
      allow write: if false;
    }

    // User docs (perfil + tokens Google). Solo el dueño lee.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
